#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

effect_name=lumasave_calibration_live
effect_dir="$HOME/.local/lib/qt6/plugins/kwin/effects/plugins"
effect_file="$effect_dir/$effect_name.so"
source_effect="$effect_dir/lumasave.so"
helper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
calibrator="$helper_dir/lumasave-calibrate"
production_was_loaded=false

cleanup() {
    trap - EXIT INT TERM
    kwriteconfig6 --file kwinrc --group Effect-lumasave --key CalibrationActive false
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect "$effect_name" >/dev/null 2>&1 || true
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "$effect_name" >/dev/null 2>&1 || true
    for key in CalibrationMode CalibrationActive CalibrationReductionPercent \
        CalibrationPerceivedBrightnessPercent CalibrationShadowDetailPercent \
        CalibrationHighlightProtectionPercent CalibrationColorIntensityPercent; do
        kwriteconfig6 --file kwinrc --group Effect-lumasave --key "$key" --delete ''
    done
    if [ -f "$effect_file" ]; then gio trash "$effect_file" 2>/dev/null || true; fi
    if [ "$production_was_loaded" = true ]; then
        qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect lumasave >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT INT TERM

if [ ! -f "$source_effect" ]; then
    kdialog --error "The LumaSave KWin effect is not installed." --title "LumaSave Calibration"
    exit 1
fi
if [ ! -x "$calibrator" ]; then
    kdialog --error "The LumaSave calibration application is not installed." --title "LumaSave Calibration"
    exit 1
fi
if qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadedEffects \
    | tr ' ' '\n' | grep -Fxq lumasave; then
    production_was_loaded=true
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect lumasave >/dev/null
fi
cp "$source_effect" "$effect_file"
kwriteconfig6 --file kwinrc --group Effect-lumasave --key CalibrationMode true
kwriteconfig6 --file kwinrc --group Effect-lumasave --key CalibrationActive false
qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$effect_name" >/dev/null
set +e
LUMASAVE_CALIBRATION_EFFECT="$effect_name" "$calibrator"
status=$?
set -e
cleanup
[ "$status" -eq 2 ] && exit 0
[ "$status" -eq 0 ] || exit "$status"

preview_config="$HOME/.config/LumaSave/Calibration.conf"
for level in 25 50 100; do
    group="Calibration-$level"
    for pair in 'PerceivedBrightnessPercent perceivedBrightness 100' \
        'ShadowDetailPercent shadowDetail 50' \
        'HighlightProtectionPercent highlightProtection 70' \
        'ColorIntensityPercent colorIntensity 100'; do
        set -- $pair
        value=$(kreadconfig6 --file "$preview_config" --group "$group" --key "$2" --default "$3")
        kwriteconfig6 --file kwinrc --group Effect-lumasave --key "Profile$level$1" "$value"
    done
done
kwriteconfig6 --file kwinrc --group Effect-lumasave --key HasCalibrationProfiles true
reduction=$(kreadconfig6 --file "$preview_config" --group Calibration-General --key maxReduction --default 10)
kwriteconfig6 --file kwinrc --group Effect-lumasave --key MaxBacklightReductionPercent "$reduction"
qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect lumasave >/dev/null 2>&1 || true
