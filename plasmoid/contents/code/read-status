#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

if status=$(qdbus6 org.kde.LumaSave /LumaSave org.kde.LumaSave.Status.statusJson 2>/dev/null); then
    printf '%s\n' "$status"
    exit 0
fi

mode=$(kreadconfig6 --file kwinrc --group Effect-lumasave --key OperatingMode --default off)
[ "$mode" = on ] && mode=idle
printf '{"mode":"%s","state":"%s","serviceAvailable":false,"reductionPercent":0}\n' \
    "$mode" "$([ "$mode" = off ] && printf off || printf unavailable)"
